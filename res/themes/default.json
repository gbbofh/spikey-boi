                 {
                     "package": "res.fonts",
                     "resource": "NotoSansSymbols.ttf"
                 }
             },
             {
                 "name": "noto_sans_symbols_2",
                 "size": "24",
                 "regular_resource":
                 {
                     "package": "res.fonts",
                     "resource": "NotoSansSymbols2.ttf"
                 }
             },
             {
                 "name": "noto_emoji",
                 "size": "24",
                 "regular_resource":
