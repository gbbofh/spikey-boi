             "normal_border": "#00000000"
         }
     },
    "window.#toggle_depth":
    {
        "misc":
        {
            "shape": "rectangle",
            "shadow_width": "0",
            "border_width": "1",
            "text_horiz_alignment_padding": "0"
        },
        "font": {
            "name": "noto_sans_symbols",
            "size": "14",
            "regular_path": "res/fonts/NotoSansSymbols.ttf"
        }
    }
